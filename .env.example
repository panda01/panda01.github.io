# Copy this file to .env (which is gitignored) and replace every value with a long random string.
# These secrets are only used by the local neko browser container (infra/neko/compose.yaml)
# and by the Express server / Playwright tests that talk to it.
NEKO_USER_PASSWORD=replace-with-a-random-string
NEKO_ADMIN_PASSWORD=replace-with-a-random-string
NEKO_API_TOKEN=replace-with-a-random-string
